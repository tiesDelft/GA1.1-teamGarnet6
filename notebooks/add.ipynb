   "source": [
    "def add(a:float,b:float):\n",
    "    return a+b\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dc85d2e5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def sum_list(numbers:list):\n",
    "    total = 0\n",
    "    for num in numbers:\n",
    "        total = add(total,num)\n",
    "    return total"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
